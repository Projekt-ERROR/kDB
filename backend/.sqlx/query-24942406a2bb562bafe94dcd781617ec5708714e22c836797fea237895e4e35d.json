  "query": "UPDATE meal_plan\n        SET\n            plan_date = COALESCE($1, plan_date),\n            meal_slot = COALESCE($2, meal_slot),\n            recipe_id = COALESCE($3, recipe_id),\n            custom_meal = COALESCE($4, custom_meal),\n            notes = COALESCE($5, notes)\n        WHERE id = $6\n        RETURNING *",
